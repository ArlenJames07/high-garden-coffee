{
  "datasets": [
    {
      "name": "3fcb5a51",
      "displayName": "Datos-Kpis",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS markets_analyzed,\n",
        "  SUM(CASE WHEN opportunity_tier = 'High' THEN 1 ELSE 0 END)\n",
        "    AS high_opportunity_markets,\n",
        "  ROUND(AVG(growth_probability) * 100, 1)\n",
        "    AS avg_growth_probability_pct,\n",
        "  ROUND(AVG(opportunity_score), 1)\n",
        "    AS avg_opportunity_score\n",
        "FROM high_garden_prod.gold.market_opportunities;"
      ]
    },
    {
      "name": "dce032ca",
      "displayName": "Datos-TopMarkets",
      "queryLines": [
        "SELECT\n",
        "  opportunity_rank,\n",
        "  country,\n",
        "  coffee_type,\n",
        "  opportunity_score,\n",
        "  opportunity_tier,\n",
        "  growth_probability,\n",
        "  forecast_consumption,\n",
        "  segment\n",
        "FROM high_garden_prod.gold.market_opportunities\n",
        "ORDER BY opportunity_rank\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "de5afaad",
      "displayName": "Datos-Demand vs growth",
      "queryLines": [
        "SELECT\n",
        "  country,\n",
        "  forecast_consumption,\n",
        "  growth_probability,\n",
        "  opportunity_score,\n",
        "  segment\n",
        "FROM high_garden_prod.gold.market_opportunities;"
      ]
    },
    {
      "name": "78555076",
      "displayName": "Datos-Model-performance",
      "queryLines": [
        "SELECT\n",
        "  model,\n",
        "  ROUND(wape * 100, 2) AS wape_pct,\n",
        "  ROUND(mase, 3) AS mase,\n",
        "  ROUND(mae, 0) AS mae,\n",
        "  ROUND(rmse, 0) AS rmse\n",
        "FROM high_garden_prod.gold.model_metrics\n",
        "ORDER BY wape ASC;"
      ]
    }
  ],
